@startuml
left to right direction
actor Utilisateur
actor Admin
rectangle VMS_Authentification {
  usecase "Se connecter" as UC1
  usecase "Recevoir JWT" as UC2
  usecase "Acceder aux ecrans autorises" as UC3
  usecase "Gerer roles/permissions" as UC4
}
Utilisateur --> UC1
Utilisateur --> UC2
Utilisateur --> UC3
Admin --> UC3
Admin --> UC4
@enduml
