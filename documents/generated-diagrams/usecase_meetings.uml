@startuml
left to right direction
actor Utilisateur
actor Admin
rectangle VMS_Reunions {
  usecase "Creer reunion" as UC1
  usecase "Consulter reunions" as UC2
  usecase "Modifier reunion" as UC3
  usecase "Changer statut" as UC4
  usecase "Supprimer reunion" as UC5
}
Utilisateur --> UC1
Utilisateur --> UC2
Utilisateur --> UC3
Utilisateur --> UC4
Admin --> UC2
Admin --> UC4
Admin --> UC5
@enduml
