@startuml
left to right direction
actor Utilisateur
actor Admin
rectangle VMS_QR {
  usecase "Generer QR d'acces" as UC1
  usecase "Scanner QR" as UC2
  usecase "Verifier validite d'acces" as UC3
  usecase "Afficher resultat" as UC4
  usecase "Auditer acces" as UC5
}
Utilisateur --> UC1
Utilisateur --> UC2
Utilisateur --> UC3
Utilisateur --> UC4
Admin --> UC3
Admin --> UC5
@enduml
