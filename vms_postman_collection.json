          }
        }
      ]
    },
    {
      "name": "Participants and Users",
      "item": [
        {
          "name": "Participant Secret",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{bearerToken}}" }],
            "url": "{{baseUrl}}/participants/{{meetingId}}/secret"
          },
          "response": [
            {
              "name": "200 UserSecretDto",
              "status": "OK",
              "code": 200,
              "body": "{\"displayName\":\"Sara Guest\",\"secret\":\"meeting-secret\"}"
            }
          ]
        },
        {
          "name": "Get User Type (public)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/{{employeeId}}"
          },
          "response": [
            {
              "name": "200 UserTypeDto",
              "status": "OK",
              "code": 200,
              "body": "{\"type\":\"employee\"}"
            }
          ]
        }
      ]
    },
    {
      "name": "Deep Links",
      "item": [
        {
          "name": "Defer Link (public)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/links/defer/{{inviteCode}}"
          }
        },
        {
          "name": "Redeem Link (public)",
          "request": {
